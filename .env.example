# Copy to `.env` and fill in. NEVER commit real secrets (the .gitignore excludes .env).

# Optional: a GitHub token, only used by gnn/data_processing.ipynb for data pulls.
GITHUB_TOKEN=

# Data root. Code reads paths relative to this (see gnn/two_stage_config.py).
DATA_DIR=./data

# If you re-add the LLM baselines (GPT-4o / Llama), set their keys here:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
